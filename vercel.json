{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "functions": {
    "api/claude.js": { "maxDuration": 30 },
    "api/scrape.js": { "maxDuration": 30 },
    "api/ping.js": { "maxDuration": 10 }
  },
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "0 6 * * *"
    }
  ]
}
